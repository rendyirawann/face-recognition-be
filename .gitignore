# ---------------------------------------------------------------------
# Rahasia. TIDAK boleh ikut ter-commit: isinya kunci yang menentukan
# siapa boleh masuk ke pemasangan ini. Yang dibagikan .env.example, dan
# setiap pemasangan membangkitkan rahasianya sendiri lewat setup.bat /
# ./setup.sh
# ---------------------------------------------------------------------
.env
.env.local
api/.env
admin/.env
admin/.env.backup

# Artefak build
api/target/
admin/vendor/
admin/node_modules/
admin/public/build/

# Data runtime — milik volume, bukan repositori
api/storage/
admin/storage/logs/*
admin/storage/framework/cache/*
admin/storage/framework/sessions/*
admin/storage/framework/views/*
admin/storage/app/public/*
admin/bootstrap/cache/*
!admin/storage/**/.gitignore

# Berkas kerja
*.log
.idea/
.vscode/
Thumbs.db
.DS_Store

# Cadangan .env buatan tangan saat pembaruan. Pola `.env` saja tidak
# menangkapnya, sehingga `git add -A` pernah nyaris mengikutkan kredensial
# basis data dan JWT ke dalam commit.
.env.bak*
.env.backup*
.env.save*

# Salah ketik `.env` yang pernah ikut ter-commit (`.enb`). Pola `.env` tidak
# menangkapnya karena namanya memang bukan `.env`.
.enb
.env.*.local

# ----------------------------------------------------------------------
# Perkakas pengembangan lokal (tidak diedarkan)
#
# Repositori ini mendokumentasikan SATU cara menjalankan sistem: Docker,
# lewat setup.bat. Berkas di bawah ini menjalankan API, dashboard, dan
# aplikasi secara native supaya ada hot reload saat mengoding, dan
# membutuhkan Rust, PHP, serta Flutter terpasang di mesin.
#
# Dibiarkan ada di disk, tetapi tidak ikut ke repositori: dua jalur yang
# sama-sama terdokumentasi hanya membuat orang memilih yang salah lalu
# tersangkut pada perkakas yang tidak mereka punya.
#
# Yang TETAP ikut karena dipakai jalur Docker:
#   setup.bat, setup.sh
#   scripts/init-compose-env.ps1, scripts/wait-http.ps1
#   scripts/seed-demo.bat
# ----------------------------------------------------------------------
/dev.bat
/dev-manual.txt
/infra/docker-compose.yml
/scripts/check-db.ps1
/scripts/init-env.ps1
/scripts/new-secrets.ps1
/scripts/open-urls.bat
/scripts/run-admin.bat
/scripts/run-api.bat
/scripts/run-app.bat
/scripts/run-db.bat
/scripts/stop.ps1
/scripts/wait-port.bat
